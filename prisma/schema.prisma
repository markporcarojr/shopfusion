generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  ACTIVE
  PAUSED
  DONE
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id      Int      @id @default(autoincrement())
  clerkId String   @unique
  email   String?  @unique
  name    String?
  role    UserRole @default(USER)

  jobs Job[]
}

model Job {
  id           Int       @id @default(autoincrement())
  jobNumber    Int?
  customerName String
  description  String?
  status       JobStatus @default(PAUSED)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  userId       Int

  timeEntries TimeEntry[]
  fusionLogs  FusionLog[]

  @@index([userId])
}

model TimeEntry {
  id    Int      @id @default(autoincrement())
  hours Float
  note  String?
  date  DateTime @default(now())
  job   Job      @relation(fields: [jobId], references: [id])
  jobId Int

  @@index([jobId])
}

model FusionLog {
  id         Int      @id @default(autoincrement())
  type       String   @default("MODEL") // "MODEL" or "DRAWING"
  modelName  String
  boundingX  Float    @default(0)
  boundingY  Float    @default(0)
  boundingZ  Float    @default(0)
  bodies     Int      @default(0)
  components String   @default("[]")
  notes      String?
  imageData  String? // base64 PNG
  createdAt  DateTime @default(now())
  job        Job?     @relation(fields: [jobId], references: [id])
  jobId      Int?

  @@index([jobId])
}
