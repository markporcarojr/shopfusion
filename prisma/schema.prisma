generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id      Int     @id @default(autoincrement())
  clerkId String  @unique
  email   String? @unique
  name    String?
  role    String  @default("USER")

  jobs Job[]
}

model Job {
  id           Int       @id @default(autoincrement())
  jobNumber    Int?
  customerName String
  description  String?
  hoursWorked  Float?
  status       String    @default("PAUSED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id])
  userId       Int

  components  Component[]
  timeEntries TimeEntry[]

  @@index([userId])
}

model Component {
  id         Int      @id @default(autoincrement())
  name       String
  material   String?
  operations String?
  notes      String?
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      Int
  createdAt  DateTime @default(now())

  fusionLogs FusionLog[]

  @@index([jobId])
}

model TimeEntry {
  id    Int      @id @default(autoincrement())
  hours Float
  note  String?
  date  DateTime @default(now())
  job   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId Int

  @@index([jobId])
}

model FusionLog {
  id          Int       @id @default(autoincrement())
  type        String    @default("MODEL")
  modelName   String
  revision    String?
  sheetSize   String?
  boundingX   Float     @default(0)
  boundingY   Float     @default(0)
  boundingZ   Float     @default(0)
  bodies      Int       @default(0)
  components  String    @default("[]")
  notes       String?
  imageData   String?
  createdAt   DateTime  @default(now())
  component   Component? @relation(fields: [componentId], references: [id], onDelete: Cascade)
  componentId Int?

  @@index([componentId])
}